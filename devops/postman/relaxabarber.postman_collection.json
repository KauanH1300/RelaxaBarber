    {
      "name": "02 · Cadastro fictício local",
      "description": "Opcional. Requer localhost:18082 e executar_escrita=true. Faz uma única gravação lógica.",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.variables.get(\"base_url\") !== \"http://localhost:18082\" || pm.variables.get(\"executar_escrita\") !== \"true\") {",
              "    pm.execution.skipRequest();",
              "}",
              "if (!pm.environment.get(\"cadastro_chave\")) {",
              "    const chave = pm.variables.replaceIn(\"{{$guid}}\");",
              "    pm.environment.set(\"cadastro_chave\", chave);",
              "    pm.environment.set(\"cadastro_telefone\", \"000\" + [...chave.replace(/-/g, \"\").slice(0, 15)]",
              "        .map(c => parseInt(c, 16) % 10).join(\"\"));",
              "    pm.environment.unset(\"cliente_id\");",
              "}"
            ]
          }
        }
      ],
      "item": [
        {
          "name": "POST /clientes · cadastrar",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const cadastro = {",
                  "    nome: \"Cliente fictício de DevOps\",",
                  "    telefone: pm.environment.get(\"cadastro_telefone\"),",
                  "    preferencias: \"Demonstração acadêmica\"",
                  "};",
                  "const filial = pm.variables.get(\"filial_id\");",
                  "if (filial) cadastro.filial_id = filial;",
                  "pm.variables.set(\"cadastro_json\", JSON.stringify(cadastro));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Estrutura e conteúdo esperados\", () => {",
                  "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
                  "    const dados = pm.response.json();",
                  "    const uuid = /^[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}$/i;",
                  "    const validar = (c) => {",
                  "        pm.expect(c.id).to.match(uuid);",
                  "        pm.expect(c.nome).to.be.a(\"string\").and.not.empty;",
                  "        pm.expect(c.telefone).to.be.a(\"string\").and.not.empty;",
                  "        pm.expect(c.email === null || typeof c.email === \"string\").to.equal(true);",
                  "        pm.expect(c.ativo).to.be.a(\"boolean\");",
                  "        pm.expect(c.conta_ativada).to.be.a(\"boolean\");",
                  "        pm.expect(Date.parse(c.data_cadastro)).to.be.finite;",
                  "    };",
                  "    validar(dados);",
                  "    pm.expect(dados.telefone).to.equal(pm.environment.get(\"cadastro_telefone\"));",
                  "    pm.expect(dados.preferencias).to.equal(\"Demonstração acadêmica\");",
                  "    pm.expect(dados.data_nascimento).to.equal(null);",
                  "    pm.environment.set(\"cliente_id\", dados.id);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{cadastro_chave}}"
              }
            ],
            "url": "{{base_url}}/clientes",
            "description": "Cadastra cliente fictício com Idempotency-Key e guarda o ID retornado.",
            "body": {
