# Configuração Geral
PROJECT_NAME="RelaxaBarber"
ENV="development"
DEBUG=True

# Conexão com o PostgreSQL
# Perfil libpq sem senha na URL; PGSERVICEFILE/PGPASSFILE são externos à imagem.
# No serviço, use somente o papel restrito. O Alembic tem contexto separado.
DATABASE_URL="postgresql+psycopg2:///?service=relaxabarber_runtime"

# Criptografia e Autenticação
SECRET_KEY="troque-por-uma-chave-secreta-aqui"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Portal de clientes: o envio fica indisponível até configurar um SMTP real.
CLIENT_PORTAL_SMTP_HOST=
CLIENT_PORTAL_SMTP_PORT=465
CLIENT_PORTAL_SMTP_TLS=ssl
CLIENT_PORTAL_SMTP_FROM=
CLIENT_PORTAL_SMTP_USER=
CLIENT_PORTAL_SMTP_PASSWORD=
# Opcional: CA privada para SMTP TLS em ambiente de testes.
CLIENT_PORTAL_SMTP_CA_FILE=
# Desativar apenas em desenvolvimento local HTTP; ambientes publicados exigem HTTPS.
CLIENT_PORTAL_COOKIE_SECURE=true

# Supabase Storage da vitrine. Configure somente no backend.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=
