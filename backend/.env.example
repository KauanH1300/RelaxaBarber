# Configuração Geral
PROJECT_NAME="RelaxaBarber"
ENV="development"
DEBUG=True

# Conexão com o PostgreSQL
# Perfil libpq sem senha na URL; PGSERVICEFILE/PGPASSFILE são externos à imagem.
# No serviço, use somente o papel restrito. O Alembic tem contexto separado.
DATABASE_URL="postgresql+psycopg2:///?service=relaxabarber_runtime"

# Criptografia e Autenticação
SECRET_KEY="troque-por-uma-chave-secreta-aqui"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
